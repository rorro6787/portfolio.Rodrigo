---
interface Props {
  id?: string
  title: string
  company: string
  workType?: string
  description: string[]
  tags?: string[]
  link?: string
  info?: string
  date: string
  duration?: string
  side?: "left" | "right"
}

const {
  id,
  title,
  company,
  workType,
  description,
  tags = [],
  link,
  info,
  date,
  duration,
  side = "left",
} = Astro.props

const isOngoing =
  date.toLowerCase().includes("present") ||
  date.toLowerCase().includes("ongoing")
---

<article id={id} data-exp-card={id} data-timeline-card={id} class="relative group scroll-mt-24">
  <!-- Desktop horizontal branch connector + center-spine node dot -->
  <div
    class:list={[
      "hidden lg:flex items-center absolute top-8 z-10 pointer-events-none",
      side === "left" ? "-right-6 flex-row" : "-left-6 flex-row-reverse",
    ]}
    aria-hidden="true"
  >
    <div
      class:list={[
        "w-6 h-[2px] transition-colors duration-200",
        isOngoing
          ? "bg-emerald-400 dark:bg-emerald-500/80"
          : "bg-amber-200 dark:bg-amber-900/60 group-hover:bg-amber-400 dark:group-hover:bg-amber-500",
      ]}
    />
    <div class="relative flex items-center justify-center w-0">
      <span
        class:list={[
          "relative w-3.5 h-3.5 rounded-full ring-4 ring-zinc-50 dark:ring-zinc-950 transition-transform duration-200 group-hover:scale-125",
          isOngoing
            ? "bg-emerald-500"
            : "bg-amber-500 dark:bg-amber-400",
        ]}
      />
    </div>
  </div>

  <!-- Mobile left-spine node dot -->
  <div
    class="lg:hidden absolute -left-[32px] top-7 z-10 flex items-center justify-center"
    aria-hidden="true"
  >
    <span
      class:list={[
        "relative w-3.5 h-3.5 rounded-full ring-4 ring-zinc-50 dark:ring-zinc-950",
        isOngoing ? "bg-emerald-500" : "bg-amber-500 dark:bg-amber-400",
      ]}
    />
  </div>

  <a
    href={link || info || "#"}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
      "exp-card block p-6 rounded-2xl transition-all duration-200 hover:-translate-y-0.5",
      isOngoing
        ? "bg-white dark:bg-zinc-900/85 border border-emerald-300 dark:border-emerald-700/70 shadow-sm hover:shadow-md hover:border-emerald-400 dark:hover:border-emerald-500"
        : "bg-white dark:bg-zinc-900/75 border border-zinc-200 dark:border-zinc-800 hover:border-amber-300 dark:hover:border-amber-700/70 hover:shadow-md",
    ]}
  >
    <!-- Header row -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2 flex-wrap mb-1">
          <h3 class="text-lg md:text-xl font-bold text-amber-600 dark:text-amber-400">
            {title}
          </h3>
          {isOngoing && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-semibold rounded-full bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/70">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
              Current
            </span>
          )}
        </div>
        <p class="text-sm md:text-base font-semibold text-zinc-800 dark:text-zinc-100">
          {company}
        </p>
      </div>

      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 text-zinc-400 group-hover:text-amber-600 dark:group-hover:text-amber-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all flex-shrink-0 mt-1.5"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
        <path d="M17 7l-10 10" />
        <path d="M8 7l9 0l0 9" />
      </svg>
    </div>

    <!-- Date / Duration / Work-type metadata -->
    <div class="flex items-center gap-2 flex-wrap mb-4">
      <time
        class:list={[
          "inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full border",
          isOngoing
            ? "text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border-emerald-200 dark:border-emerald-800/70"
            : "text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/50 border-amber-200 dark:border-amber-800/60",
        ]}
      >
        {date}
      </time>
      {duration && (
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full text-zinc-600 dark:text-zinc-400 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200/80 dark:border-zinc-700/70">
          {duration}
        </span>
      )}
      {workType && (
        <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full text-zinc-600 dark:text-zinc-400 bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200/80 dark:border-zinc-700/70">
          {workType}
        </span>
      )}
    </div>

    <!-- Description -->
    <div class="space-y-2.5 text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
      {description.map((desc) => (
        <p>{desc}</p>
      ))}
    </div>

    <!-- Key tech / focus pills -->
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-4 pt-3.5 border-t border-zinc-200 dark:border-zinc-800">
        {tags.map((tag) => (
          <span class="px-2.5 py-0.5 text-[11px] font-medium rounded-md text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/70">
            {tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>

<style>
  :global([data-timeline-card].is-highlighted .exp-card) {
    border-color: rgb(37 99 235 / 0.8);
    box-shadow: 0 0 0 2px rgb(37 99 235 / 0.2);
    transform: translateY(-2px);
  }
</style>
