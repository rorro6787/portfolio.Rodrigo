---
import GitHub from "./icons/GitHub.astro"
import ORACLE from "./icons/Oracle.astro"
import MAIL from "./icons/System.astro"
import Pytorch from "./icons/Pytorch.astro"
import Python from "./icons/Python.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Numpy from "./icons/Numpy.astro"
import Yolo from "./icons/Yolo.astro"
import HuggingFace from "./icons/HuggingFace.astro"
import Next from "./icons/Next.astro"
import Pandas from "./icons/Pandas.astro"
import { PROJECT_ITEMS, type ProjectTagKey } from "@/data/portfolio"

const TAGS: Record<
  ProjectTagKey,
  { name: string; class: string; icon: any }
> = {
  Oracle: {
    name: "Oracle Cloud Infrastucture",
    class: "bg-[#003159] text-white",
    icon: ORACLE,
  },
  Next: {
    name: "React & Next.js",
    class: "bg-[#003159] text-white",
    icon: Next,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#003159] text-white",
    icon: Python,
  },
  PYTORCH: {
    name: "Pytorch",
    class: "bg-[#003159] text-white",
    icon: Pytorch,
  },
  NUMPY: {
    name: "Numpy",
    class: "bg-[#003159] text-white",
    icon: Numpy,
  },
  YOLO: {
    name: "YOLO",
    class: "bg-[#003159] text-white",
    icon: Yolo,
  },
  HUGGINGFACE: {
    name: "HuggingFace",
    class: "bg-[#003159] text-white",
    icon: HuggingFace,
  },
  PANDAS: {
    name: "Pandas",
    class: "bg-[#0077B6] text-white",
    icon: Pandas,
  },
}
---


<div class="flex flex-col gap-y-16">
  {
    PROJECT_ITEMS.map(({ id, date, image, title, description, tagKeys, link, github, preview }, index) => {
      const tags = tagKeys.map((key) => TAGS[key])
      return (
    <article id={id} data-timeline-card={id} class="project-item group scroll-mt-24" style={`animation-delay: ${index * 0.2}s`}>
      <div class="project-content w-full">
        <div class="proj-card bg-white dark:bg-zinc-900/75 rounded-2xl border border-zinc-200 dark:border-zinc-800 hover:border-indigo-300 dark:hover:border-indigo-700/70 hover:shadow-md transition-all duration-300 flex flex-col w-full overflow-hidden hover:-translate-y-0.5">
          
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-4">
              <div class="flex items-start gap-3 flex-1 min-w-0">
                <div class="flex-shrink-0 mt-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-indigo-600 dark:text-indigo-400" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M7 8l-4 4l4 4" />
                    <path d="M17 8l4 4l-4 4" />
                    <path d="M14 4l-4 16" />
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 project-title flex-1">
                  {title}
                </h3>
              </div>
              <time class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/70 flex-shrink-0">
                {date}
              </time>
            </div>

            <div class="project-image-wrapper relative transition duration-500 ease-in-out transform overflow-hidden rounded-lg mb-4 max-w-sm md:float-right md:ml-6 md:mb-6 mx-auto md:mx-0">
              <img alt={title} class="w-full h-auto object-contain transition duration-500 md:group-hover:scale-105" src={image} />
            </div>

            <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag, tagIndex) => (
          <span
            class={`project-tag inline-flex items-center gap-1.5 rounded-full text-xs ${tag.class} py-1.5 px-3`}
            style={`animation-delay: ${index * 0.2 + tagIndex * 0.1 + 0.4}s`}
          >
            <tag.icon class="size-4" />
            {tag.name}
          </span>
        ))}
            </div>

            <footer class="flex flex-wrap items-center gap-3 mb-4 project-footer">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-5" />
                  Code
                </LinkButton>
              )}
              
              {link && (
                <LinkButton href={link}>
                  <Link class="size-5" />
                  Docs
                </LinkButton>
              )}
              
              {preview && (
                <LinkButton href={preview}>
                  <MAIL class="size-5" />
                  PyPI
                </LinkButton>
              )}
            </footer>

            <p class="text-zinc-600 dark:text-zinc-300 leading-relaxed project-description mb-4">
              {description}
            </p>
            
            <div class="clear-both md:clear-both"></div>
          </div>
        </div>
      </div>
    </article>
      )
    })
  }
</div>

<style>
  :global([data-timeline-card].is-highlighted .proj-card) {
    border-color: rgb(79 70 229 / 0.8);
    box-shadow: 0 0 0 2px rgb(79 70 229 / 0.2);
    transform: translateY(-2px);
  }
  .project-item {
    opacity: 0;
    animation: fadeInScale 0.8s ease-out forwards;
  }

  .project-image-wrapper {
    opacity: 0;
    animation: fadeInScale 0.8s ease-out forwards;
    animation-delay: calc(var(--delay, 0s) + 0.1s);
  }

  .project-content {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out forwards;
    animation-delay: inherit;
  }

  .project-title {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .project-title {
    animation-delay: calc(var(--delay, 0s) + 0.2s);
  }

  .project-tag {
    opacity: 0;
    animation: popIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  }

  .project-description {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .project-description {
    animation-delay: calc(var(--delay, 0s) + 0.5s);
  }

  .project-footer {
    opacity: 0;
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .project-footer {
    animation-delay: calc(var(--delay, 0s) + 0.7s);
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes popIn {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>



