---
import GitHub from "./icons/GitHub.astro"
import MAIL from "./icons/System.astro"
import Python from "./icons/Python.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import {
  PROJECT_ITEMS,
  type ProjectEcosystemNode,
} from "@/data/portfolio"

const MODULE_ACCENTS: Record<
  ProjectEcosystemNode["accent"],
  {
    border: string
    badge: string
    iconBox: string
    dot: string
  }
> = {
  indigo: {
    border: "hover:border-indigo-300 dark:hover:border-indigo-700/80",
    badge:
      "bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800/70",
    iconBox:
      "bg-indigo-100/80 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-300",
    dot: "bg-indigo-500",
  },
  sky: {
    border: "hover:border-sky-300 dark:hover:border-sky-700/80",
    badge:
      "bg-sky-50 dark:bg-sky-950/70 text-sky-700 dark:text-sky-300 border-sky-200 dark:border-sky-800/70",
    iconBox: "bg-sky-100/80 dark:bg-sky-950/80 text-sky-600 dark:text-sky-300",
    dot: "bg-sky-500",
  },
  emerald: {
    border: "hover:border-emerald-300 dark:hover:border-emerald-700/80",
    badge:
      "bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/70",
    iconBox:
      "bg-emerald-100/80 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-300",
    dot: "bg-emerald-500",
  },
  violet: {
    border: "hover:border-violet-300 dark:hover:border-violet-700/80",
    badge:
      "bg-violet-50 dark:bg-violet-950/70 text-violet-700 dark:text-violet-300 border-violet-200 dark:border-violet-800/70",
    iconBox:
      "bg-violet-100/80 dark:bg-violet-950/80 text-violet-600 dark:text-violet-300",
    dot: "bg-violet-500",
  },
}
---

<div class="flex flex-col gap-y-16">
  {
    PROJECT_ITEMS.map(
      (
        {
          id,
          date,
          image,
          title,
          subtitle,
          badge,
          installHint,
          docLabel,
          description,
          link,
          github,
          preview,
          evolution,
        },
        index
      ) => {
        if (evolution) {
          const { legacy, current } = evolution
          return (
            <article
              id={id}
              data-timeline-card={id}
              class="project-item group scroll-mt-24"
              style={`animation-delay: ${index * 0.2}s`}
            >
              <div class="project-content w-full">
                <div class="proj-card bg-white dark:bg-zinc-900/75 rounded-2xl border border-zinc-200 dark:border-zinc-800 hover:border-indigo-300 dark:hover:border-indigo-700/70 hover:shadow-md transition-all duration-300 flex flex-col w-full overflow-hidden">
                  <div class="p-6">
                    <!-- Header -->
                    <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
                      <div class="flex items-start gap-3 flex-1 min-w-0">
                        <div class="flex-shrink-0 mt-1">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-6 h-6 text-indigo-600 dark:text-indigo-400"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M7 18a2 2 0 1 0 0 -4a2 2 0 0 0 0 4z" />
                            <path d="M7 6a2 2 0 1 0 0 4a2 2 0 0 0 0 -4z" />
                            <path d="M17 18a2 2 0 1 0 0 -4a2 2 0 0 0 0 4z" />
                            <path d="M7 10v4" />
                            <path d="M7 10c0 3 10 1 10 4" />
                          </svg>
                        </div>
                        <div class="min-w-0">
                          <h3 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 project-title">
                            {title}
                          </h3>
                          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
                            Project Evolution Tree · From standalone library to
                            multi-repo scientific ecosystem
                          </p>
                        </div>
                      </div>
                      <time class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/70 flex-shrink-0">
                        Sept 2024 – {date}
                      </time>
                    </div>

                    <!-- Evolution Tree -->
                    <div class="flex flex-col">
                      <!-- 1. Legacy v1.0 Origin Node -->
                      <div class="group/legacy relative rounded-xl border border-dashed border-zinc-300 dark:border-zinc-700/80 bg-zinc-50/80 dark:bg-zinc-950/50 p-4 sm:p-5 transition-colors hover:border-zinc-400 dark:hover:border-zinc-600">
                        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                          <div class="flex-shrink-0 w-full sm:w-44 aspect-video rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 overflow-hidden shadow-xs">
                            <img
                              src={legacy.image}
                              alt={legacy.title}
                              class="w-full h-full object-cover opacity-85 grayscale-[25%] group-hover/legacy:grayscale-0 group-hover/legacy:opacity-100 group-hover/legacy:scale-105 transition duration-300"
                            />
                          </div>

                          <div class="flex-1 min-w-0">
                            <div class="flex flex-wrap items-center gap-2 mb-1">
                              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 dark:bg-amber-950/60 text-amber-800 dark:text-amber-300 border border-amber-200/90 dark:border-amber-800/70">
                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500" />
                                {legacy.status}
                              </span>
                              <span class="px-2 py-0.5 rounded-md text-[11px] font-mono font-medium bg-zinc-200/70 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                                {legacy.version}
                              </span>
                              <span class="text-xs text-zinc-500 dark:text-zinc-400">
                                {legacy.date}
                              </span>
                            </div>

                            <h4 class="text-base font-semibold text-zinc-800 dark:text-zinc-200">
                              {legacy.title}
                            </h4>
                            <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-2">
                              {legacy.subtitle}
                            </p>
                            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-3">
                              {legacy.description}
                            </p>

                            <div class="flex flex-wrap items-center gap-2">
                              {legacy.links.map((item) => (
                                <a
                                  href={item.href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium text-zinc-600 dark:text-zinc-300 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 hover:text-zinc-900 dark:hover:text-white transition"
                                >
                                  {item.kind === "github" && (
                                    <GitHub class="size-3.5" />
                                  )}
                                  {item.kind === "docs" && (
                                    <Link class="size-3.5" />
                                  )}
                                  {item.kind === "pypi" && (
                                    <MAIL class="size-3.5" />
                                  )}
                                  {item.label}
                                </a>
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Evolution Trunk Connector (v1 -> v2) -->
                      <div class="relative flex flex-col items-center py-2.5">
                        <div
                          class="w-[2px] h-4 bg-gradient-to-b from-zinc-300 to-indigo-400 dark:from-zinc-700 dark:to-indigo-500"
                          aria-hidden="true"
                        />
                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-indigo-50 dark:bg-indigo-950/80 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/80 shadow-sm">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="size-3.5"
                            viewBox="0 0 24 24"
                            stroke-width="2.2"
                            stroke="currentColor"
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M12 5l0 14" />
                            <path d="M16 15l-4 4" />
                            <path d="M8 15l4 4" />
                          </svg>
                          Evolved into v2.0 Ecosystem · {current.date}
                        </div>
                        <div
                          class="w-[2px] h-4 bg-gradient-to-b from-indigo-400 to-indigo-500 dark:from-indigo-500 dark:to-indigo-400"
                          aria-hidden="true"
                        />
                      </div>

                      <!-- 2. Current SAES 2.0 Root Node -->
                      <div class="relative rounded-xl border border-indigo-200/90 dark:border-indigo-800/70 bg-gradient-to-br from-indigo-50/70 via-white to-sky-50/40 dark:from-indigo-950/35 dark:via-zinc-900/90 dark:to-sky-950/20 p-5 shadow-sm">
                        <div class="flex flex-col sm:flex-row sm:items-start gap-4">
                          <div class="flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden shadow-md ring-1 ring-indigo-200/70 dark:ring-indigo-700/50">
                            <img
                              src={current.image}
                              alt={current.title}
                              class="w-full h-full object-cover"
                            />
                          </div>

                          <div class="flex-1 min-w-0">
                            <div class="flex flex-wrap items-center gap-2 mb-1.5">
                              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/70">
                                <span class="relative flex h-2 w-2">
                                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75" />
                                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500" />
                                </span>
                                {current.status}
                              </span>
                              <span class="px-2 py-0.5 rounded-md text-[11px] font-mono font-semibold bg-indigo-100 dark:bg-indigo-900/60 text-indigo-800 dark:text-indigo-200">
                                {current.version}
                              </span>
                            </div>

                            <h4 class="text-xl font-bold text-zinc-900 dark:text-zinc-100">
                              {current.title}
                            </h4>
                            <p class="text-xs font-medium text-indigo-700 dark:text-indigo-300 mb-2.5">
                              {current.subtitle}
                            </p>
                            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed mb-4">
                              {current.description}
                            </p>

                            <div class="flex flex-wrap items-center gap-2.5">
                              {current.primaryLinks.map((item) => (
                                <LinkButton href={item.href}>
                                  {item.kind === "github" && (
                                    <GitHub class="size-4" />
                                  )}
                                  {item.kind === "docs" && (
                                    <Link class="size-4" />
                                  )}
                                  {item.kind === "pypi" && (
                                    <MAIL class="size-4" />
                                  )}
                                  {item.kind === "external" && (
                                    <svg
                                      xmlns="http://www.w3.org/2000/svg"
                                      class="size-4"
                                      viewBox="0 0 24 24"
                                      stroke-width="2"
                                      stroke="currentColor"
                                      fill="none"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    >
                                      <path
                                        stroke="none"
                                        d="M0 0h24v24H0z"
                                        fill="none"
                                      />
                                      <path d="M12 3l8 4.5l0 9l-8 4.5l-8 -4.5l0 -9l8 -4.5" />
                                      <path d="M12 12l8 -4.5" />
                                      <path d="M12 12l0 9" />
                                      <path d="M12 12l-8 -4.5" />
                                    </svg>
                                  )}
                                  {item.label}
                                </LinkButton>
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>

                      <!-- Branch Connector from SAES 2.0 Root to 4 Ecosystem Pillars -->
                      <div
                        class="hidden md:flex flex-col items-center"
                        aria-hidden="true"
                      >
                        <div class="w-[2px] h-5 bg-indigo-300 dark:bg-indigo-700/80" />
                        <div class="relative w-1/2 h-4 border-t-2 border-l-2 border-r-2 border-indigo-300 dark:border-indigo-700/80 rounded-t-xl" />
                      </div>

                      <!-- 3. Ecosystem Modules Grid (4 Branches) -->
                      <div class="mt-4 md:mt-0 pl-4 md:pl-0 border-l-2 md:border-l-0 border-indigo-200 dark:border-indigo-800/70 grid grid-cols-1 md:grid-cols-2 gap-3.5">
                        {current.modules.map((mod) => {
                          const style = MODULE_ACCENTS[mod.accent]
                          return (
                            <div
                              class={`relative flex flex-col justify-between rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/90 p-4 transition-all duration-200 hover:shadow-sm ${style.border}`}
                            >
                              <div>
                                <div class="flex items-start justify-between gap-2 mb-2.5">
                                  <div class="flex items-center gap-2.5 min-w-0">
                                    <span
                                      class={`flex-shrink-0 w-8 h-8 rounded-lg flex items-center justify-center ${style.iconBox}`}
                                    >
                                      {mod.icon === "python" && (
                                        <Python class="size-4" />
                                      )}
                                      {mod.icon === "desktop" && (
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          class="size-4"
                                          viewBox="0 0 24 24"
                                          stroke-width="2"
                                          stroke="currentColor"
                                          fill="none"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                        >
                                          <path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"
                                          />
                                          <path d="M3 5a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v10a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1v-10z" />
                                          <path d="M7 20h10" />
                                          <path d="M9 16v4" />
                                          <path d="M15 16v4" />
                                        </svg>
                                      )}
                                      {mod.icon === "ai" && (
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          class="size-4"
                                          viewBox="0 0 24 24"
                                          stroke-width="2"
                                          stroke="currentColor"
                                          fill="none"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                        >
                                          <path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"
                                          />
                                          <path d="M12 3l1.912 5.813a2 2 0 0 0 1.275 1.275l5.813 1.912l-5.813 1.912a2 2 0 0 0 -1.275 1.275l-1.912 5.813l-1.912 -5.813a2 2 0 0 0 -1.275 -1.275l-5.813 -1.912l5.813 -1.912a2 2 0 0 0 1.275 -1.275l1.912 -5.813z" />
                                        </svg>
                                      )}
                                      {mod.icon === "plugin" && (
                                        <svg
                                          xmlns="http://www.w3.org/2000/svg"
                                          class="size-4"
                                          viewBox="0 0 24 24"
                                          stroke-width="2"
                                          stroke="currentColor"
                                          fill="none"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"
                                        >
                                          <path
                                            stroke="none"
                                            d="M0 0h24v24H0z"
                                            fill="none"
                                          />
                                          <path d="M4 7h3a1 1 0 0 0 1 -1v-1a2 2 0 0 1 4 0v1a1 1 0 0 0 1 1h3a1 1 0 0 1 1 1v3a1 1 0 0 0 1 1h1a2 2 0 0 1 0 4h-1a1 1 0 0 0 -1 1v3a1 1 0 0 1 -1 1h-3a1 1 0 0 1 -1 -1v-1a2 2 0 0 0 -4 0v1a1 1 0 0 1 -1 1h-3a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1h1a2 2 0 0 0 0 -4h-1a1 1 0 0 1 -1 -1v-3a1 1 0 0 1 1 -1" />
                                        </svg>
                                      )}
                                    </span>
                                    <div class="min-w-0">
                                      <div class="flex items-center gap-1.5">
                                        <h5 class="text-sm font-bold font-mono text-zinc-900 dark:text-zinc-100 truncate">
                                          {mod.name}
                                        </h5>
                                        <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400">
                                          {mod.version}
                                        </span>
                                      </div>
                                      <p class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate">
                                        {mod.role}
                                      </p>
                                    </div>
                                  </div>
                                  <span
                                    class={`flex-shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold border ${style.badge}`}
                                  >
                                    {mod.badge}
                                  </span>
                                </div>

                                <p class="text-xs text-zinc-600 dark:text-zinc-300 leading-relaxed mb-3">
                                  {mod.description}
                                </p>
                              </div>

                              <div class="flex flex-wrap items-center justify-between gap-2 pt-2.5 border-t border-zinc-100 dark:border-zinc-800/80">
                                <div class="flex flex-wrap items-center gap-1.5">
                                  {mod.links.map((item) => (
                                    <a
                                      href={item.href}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-medium bg-zinc-50 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-700/80 hover:bg-zinc-900 hover:text-white hover:border-zinc-900 dark:hover:bg-zinc-100 dark:hover:text-zinc-900 dark:hover:border-zinc-100 transition"
                                    >
                                      {item.kind === "github" && (
                                        <GitHub class="size-3" />
                                      )}
                                      {item.kind === "docs" && (
                                        <Link class="size-3" />
                                      )}
                                      {item.kind === "pypi" && (
                                        <MAIL class="size-3" />
                                      )}
                                      {item.label}
                                    </a>
                                  ))}
                                </div>

                                {mod.installHint && (
                                  <code class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/90 text-zinc-600 dark:text-zinc-300 select-all">
                                    {mod.installHint}
                                  </code>
                                )}
                              </div>
                            </div>
                          )
                        })}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          )
        }

        return (
          <article
            id={id}
            data-timeline-card={id}
            class="project-item group scroll-mt-24"
            style={`animation-delay: ${index * 0.2}s`}
          >
            <div class="project-content w-full">
              <div class="proj-card bg-white dark:bg-zinc-900/75 rounded-2xl border border-zinc-200 dark:border-zinc-800 hover:border-indigo-300 dark:hover:border-indigo-700/70 hover:shadow-md transition-all duration-300 flex flex-col w-full overflow-hidden">
                <div class="p-6">
                  <!-- Header -->
                  <div class="flex flex-wrap items-start justify-between gap-3 mb-5">
                    <div class="flex items-start gap-3 flex-1 min-w-0">
                      <div class="flex-shrink-0 mt-1">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-6 h-6 text-indigo-600 dark:text-indigo-400"
                          viewBox="0 0 24 24"
                          stroke-width="2"
                          stroke="currentColor"
                          fill="none"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M7 8l-4 4l4 4" />
                          <path d="M17 8l4 4l-4 4" />
                          <path d="M14 4l-4 16" />
                        </svg>
                      </div>
                      <div class="min-w-0">
                        <h3 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100 project-title">
                          {title}
                        </h3>
                        {subtitle && (
                          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
                            {subtitle}
                          </p>
                        )}
                      </div>
                    </div>
                    <time class="inline-flex items-center px-3 py-1 text-xs font-medium rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/70 flex-shrink-0">
                      {date}
                    </time>
                  </div>

                  <!-- Main Panel (same left-media + right-content style as SAES) -->
                  <div class="rounded-xl border border-zinc-200/90 dark:border-zinc-800 bg-gradient-to-br from-indigo-50/40 via-white to-sky-50/30 dark:from-indigo-950/20 dark:via-zinc-900/90 dark:to-sky-950/15 p-5">
                    <div class="flex flex-col sm:flex-row sm:items-start gap-5">
                      <div class="project-image-wrapper flex-shrink-0 w-full sm:w-52 rounded-xl bg-white dark:bg-zinc-950/70 border border-zinc-200/90 dark:border-zinc-800 overflow-hidden shadow-xs">
                        <img
                          alt={title}
                          class="w-full h-auto block object-cover transition duration-500 group-hover:scale-105"
                          src={image}
                        />
                      </div>

                      <div class="flex-1 min-w-0">
                        {(badge || installHint) && (
                          <div class="flex flex-wrap items-center gap-2 mb-2.5">
                            {badge && (
                              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-indigo-50 dark:bg-indigo-950/70 text-indigo-700 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800/70">
                                <span class="w-1.5 h-1.5 rounded-full bg-indigo-500" />
                                {badge}
                              </span>
                            )}
                            {installHint && (
                              <code class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800/90 text-zinc-600 dark:text-zinc-300 border border-zinc-200/80 dark:border-zinc-700/70 select-all">
                                {installHint}
                              </code>
                            )}
                          </div>
                        )}

                        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed project-description mb-4">
                          {description}
                        </p>

                        <footer class="flex flex-wrap items-center gap-2.5 project-footer">
                          {github && (
                            <LinkButton href={github}>
                              <GitHub class="size-4" />
                              Code
                            </LinkButton>
                          )}

                          {link && (
                            <LinkButton href={link}>
                              <Link class="size-4" />
                              {docLabel ?? "Docs"}
                            </LinkButton>
                          )}

                          {preview && (
                            <LinkButton href={preview}>
                              <MAIL class="size-4" />
                              PyPI
                            </LinkButton>
                          )}
                        </footer>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        )
      }
    )
  }
</div>

