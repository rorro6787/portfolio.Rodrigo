---
const { class: className, id } = Astro.props
---

<section
  id={id}
  data-section={id}
  class={`section animate-on-scroll ${className} scroll-m-20 w-full mx-auto container lg:max-w-4xl md:max-w-2xl opacity-0 translate-y-10 transition-all duration-700 ease-out`}
>
  <slot />
</section>

<style>
  section.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>
