---
import LanguageCertificationsItem from "./LanguageCertificationsItem.astro"
import { LANGUAGE_CERTIFICATIONS } from "@/data/portfolio"
---

<ol class="relative mt-12 pl-6 ml-3 border-l-2 border-violet-200 dark:border-violet-900/50 space-y-6">
  {
    LANGUAGE_CERTIFICATIONS.map((cert) => (
      <li>
        <LanguageCertificationsItem {...cert} />
      </li>
    ))
  }
</ol>
