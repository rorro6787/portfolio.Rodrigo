---
const personalImageAlt = "Miguel Ángel"
import Badge from "@/components/Badge.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"
import SocialPill from "@/components/SocialPill.astro"
import YoutubeInIcon from "@/components/icons/Youtube.astro"
import GithubIcon from "@/components/icons/GitHub.astro"
---

<div class="max-w-xl hero-container">
  <div class="flex gap-4 mb-4 hero-header">
    <img
      class="rounded-full shadow-lg size-16 hero-image"
      src="/me.png"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/emilio-rodrigo-carreira-villalta-2a62aa250/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105 hero-badge"
    >
      <!--
      <Badge>Available</Badge>
      -->
      <Badge>Available</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white hero-title"
  >
    Hey, I am Rodrigo Carreira
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-transparent dark:[&>strong]:bg-clip-text dark:[&>strong]:bg-gradient-to-r dark:[&>strong]:from-blue-400 dark:[&>strong]:to-emerald-400 [&>strong]:text-blue-600 [&>strong]:font-semibold dark:text-gray-300 hero-description"
  >
    <strong>Head of Engineering</strong> at the <strong>Ceuta Tax Authority</strong>. 
  Specializing in leading the <strong>digital transformation</strong> and 
  <strong>technological transition</strong> of public administration through 
  strategic infrastructure and AI-driven efficiency.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8 hero-social">
    <SocialPill href="mailto:ercarreira2@gmail.com">
      <MailIcon class="size-5" />
      Contact Me
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/emilio-rodrigo-carreira-villalta-2a62aa250/">
      <LinkedInIcon class="size-5" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://www.youtube.com/@RodrigoCarreira3382">
      <YoutubeInIcon class="size-5" />
      Youtube
    </SocialPill>
    <SocialPill href="https://github.com/rorro6787">
      <GithubIcon class="size-5" />
      Github
    </SocialPill>
  </nav>
</div>

<style>
  .hero-container {
    animation: blurFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-header {
    opacity: 0;
    transform: translateY(10px) scale(0.95);
    filter: blur(4px);
    animation: springFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.1s;
  }

  .hero-image {
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .hero-image:hover {
    transform: scale(1.1) rotate(-5deg);
  }

  .hero-badge {
    opacity: 0;
    transform: scale(0.9) translateY(10px);
    filter: blur(2px);
    animation: springFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.3s;
  }

  .hero-title {
    opacity: 0;
    transform: translateX(-20px);
    filter: blur(4px);
    animation: slideBlurIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.2s;
  }

  .hero-description {
    opacity: 0;
    transform: translateY(20px);
    filter: blur(4px);
    animation: springFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.4s;
  }

  .hero-social {
    opacity: 0;
    transform: translateY(20px);
    filter: blur(4px);
    animation: springFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.5s;
  }

  @keyframes blurFadeIn {
    from {
      opacity: 0;
      filter: blur(10px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes springFade {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  @keyframes slideBlurIn {
    from {
      opacity: 0;
      transform: translateX(-30px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
      filter: blur(0);
    }
  }
</style>
