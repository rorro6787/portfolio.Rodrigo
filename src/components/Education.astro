---
import EducationItem from "./EducationItem.astro"
import { EDUCATION_ITEMS } from "@/data/portfolio"
---

<ol class="relative mt-12 pl-6 ml-3 border-l-2 border-emerald-200 dark:border-emerald-900/50 space-y-6">
  {
    EDUCATION_ITEMS.map((item) => (
      <li>
        <EducationItem {...item} />
      </li>
    ))
  }
</ol>
