---
import CertificationsItem from "./CertificationsItem.astro"
import { TECHNICAL_CERTIFICATIONS } from "@/data/portfolio"

// Group certifications by company
const groupedByCompany = TECHNICAL_CERTIFICATIONS.reduce((acc, cert) => {
  if (!acc[cert.company]) {
    acc[cert.company] = []
  }
  acc[cert.company].push(cert)
  return acc
}, {} as Record<string, typeof TECHNICAL_CERTIFICATIONS>)

// Sort companies to have the most certifications first
const sortedCompanies = Object.entries(groupedByCompany).sort(
  ([, a], [, b]) => b.length - a.length
)
---

<div class="relative mt-16 certifications-container">
  {
    sortedCompanies.map(([company, certs], companyIndex) => (
      <details class="company-group" data-company={company} style={`animation-delay: ${companyIndex * 0.15}s`}>
        <summary class="company-header">
          <div class="company-info">
            <div class="company-badge">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M3 21l18 0" />
                <path d="M9 8l1 0" />
                <path d="M9 12l1 0" />
                <path d="M9 16l1 0" />
                <path d="M14 8l1 0" />
                <path d="M14 12l1 0" />
                <path d="M14 16l1 0" />
                <path d="M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16" />
              </svg>
            </div>
            <div class="company-details">
              <h3 class="company-name">{company}</h3>
              <span class="cert-count">{certs.length} {certs.length === 1 ? 'certification' : 'certifications'}</span>
            </div>
          </div>
          <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M6 9l6 6l6 -6" />
          </svg>
        </summary>
        <div class="certifications-list">
          {certs.map((cert, index) => (
            <div class="certification-item-wrapper" style={`animation-delay: ${index * 0.1}s`}>
              <CertificationsItem {...cert} />
            </div>
          ))}
        </div>
      </details>
    ))
  }
</div>

<style>
  .certifications-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .company-group {
    background: rgb(255 255 255);
    border: 1px solid rgb(228 228 231);
    border-radius: 1rem;
    padding: 0.25rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .company-group:hover {
    border-color: rgb(212 212 216);
    box-shadow: 0 4px 12px -2px rgb(0 0 0 / 0.06);
  }

  :global(.dark) .company-group {
    background: rgb(24 24 27 / 0.65);
    border-color: rgb(39 39 42);
  }

  :global(.dark) .company-group:hover {
    border-color: rgb(63 63 70);
  }

  .company-group[open] {
    padding-bottom: 1.25rem;
  }

  .company-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    transition: background-color 0.2s ease;
    list-style: none;
  }

  .company-header::-webkit-details-marker {
    display: none;
  }

  .company-header:hover {
    background: rgb(244 244 245 / 0.7);
  }

  :global(.dark) .company-header:hover {
    background: rgb(39 39 42 / 0.5);
  }

  .company-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .company-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    background: rgb(239 246 255);
    border: 1px solid rgb(191 219 254);
    border-radius: 0.75rem;
    color: rgb(37 99 235);
    transition: transform 0.2s ease;
  }

  :global(.dark) .company-badge {
    background: rgb(23 37 84 / 0.6);
    border-color: rgb(30 64 175 / 0.6);
    color: rgb(96 165 250);
  }

  .company-group:hover .company-badge {
    transform: scale(1.04);
  }

  .company-details {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .company-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: rgb(24 24 27);
    margin: 0;
  }

  :global(.dark) .company-name {
    color: rgb(244 244 245);
  }

  .cert-count {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(29 78 216);
    background: rgb(239 246 255);
    border: 1px solid rgb(191 219 254);
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    width: fit-content;
  }

  :global(.dark) .cert-count {
    color: rgb(147 197 253);
    background: rgb(23 37 84 / 0.6);
    border-color: rgb(30 64 175 / 0.6);
  }

  .chevron {
    color: rgb(113 113 122);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  :global(.dark) .chevron {
    color: rgb(161 161 170);
  }

  .company-group[open] .chevron {
    transform: rotate(180deg);
  }

  .certifications-list {
    padding: 0.75rem 1.25rem 0;
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .certifications-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const companyGroups = document.querySelectorAll('.company-group')
    
    companyGroups.forEach(group => {
      group.addEventListener('toggle', (e) => {
        const target = e.target as HTMLDetailsElement
        if (target.open) {
          // Scroll into view when opened
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
          }, 100)
        }
      })
    })
  })
</script>
