---
import ExperienceItem from "./ExperienceItem.astro"

// Function to calculate duration between two dates
function calculateDuration(startDate: Date, endDate: Date): string {
  const totalMonths = (endDate.getFullYear() - startDate.getFullYear()) * 12 + 
                      (endDate.getMonth() - startDate.getMonth())
  
  const years = Math.floor(totalMonths / 12)
  const months = totalMonths % 12
  
  if (years === 0 && months === 0) {
    return "Less than a month"
  } else if (years === 0) {
    return `${months} ${months === 1 ? 'month' : 'months'}`
  } else if (months === 0) {
    return `${years} ${years === 1 ? 'year' : 'years'}`
  } else {
    return `${years} ${years === 1 ? 'year' : 'years'} ${months} ${months === 1 ? 'month' : 'months'}`
  }
}

// Function to parse date string (handles formats like "March 2025", "Sept. 2024", etc.)
function parseDate(dateStr: string): Date {
  const monthMap: { [key: string]: number } = {
    'jan': 0, 'january': 0,
    'feb': 1, 'february': 1,
    'mar': 2, 'march': 2,
    'apr': 3, 'april': 3,
    'may': 4,
    'jun': 5, 'june': 5,
    'jul': 6, 'july': 6,
    'aug': 7, 'august': 7,
    'sep': 8, 'sept': 8, 'september': 8,
    'oct': 9, 'october': 9,
    'nov': 10, 'november': 10,
    'dec': 11, 'december': 11
  }
  
  const cleaned = dateStr.toLowerCase().replace(/\./g, '').trim()
  const parts = cleaned.split(/\s+/)
  
  const month = monthMap[parts[0]]
  const year = parseInt(parts[1])
  
  return new Date(year, month, 1)
}

const EXPERIENCE = [
  {
    date: "March 2025 - Ongoing",
    title: "Jr. AI Software Engineer",
    company: "Tupl Inc.",
    description: ["Developed and deployed AI, ML, and GenAI solutions across internal TuplOS tools and enterprise services, integrating LLMs, RAG pipelines, and AI agents to automate workflows and enhance system intelligence. Designed and implemented an agentic framework supporting MCP, A2A communication, RAGs, and multi-agent orchestration, enabling the creation and deployment of custom AI agents for diverse use cases across the company and partner ecosystems", "As a qualified software engineer, led the end-to-end development lifecycle of AI-driven systems, including architecture design, CI/CD pipeline implementation using Jenkins, and production deployment using Kubernetes and Docker. Designed scalable microservice architectures, created and maintained Helm charts for automated Kubernetes deployments, and implemented cluster monitoring and service management to ensure reliability and scalability. Applied modern software design patterns, optimized database integration, and collaborated cross-functionally to deliver robust, secure, and high-performance enterprise solutions aligned with business objectives"], 
    link: "https://www.tupl.com/",
  },
  {
    date: "Sept. 2024 - June 2025",
    title: "AI Researcher",
    company: "Scenic and KHAOS Research Group, ITIS UMA",
    description: ["Coauthored and published the SAES Python library for non-parametric statistical tests with researcher Antonio J. Nebro, enabling advanced statistical analysis and visualization. Conducted research on automatic code generation using Large Language Models (LLMs), integrating LangChain with frameworks such as jMetal and jMetalPy for multi-objective optimization.", "Developed business process optimization solutions using machine learning (ML) and Graph Neural Networks (GNNs). Worked with Business Process Model and Notation (BPMN) tools such as Activiti, Bonita BPM, and Camunda. Applied my knowledge of artificial intelligence, focusing on machine learning and GNNs, while also utilizing genetic algorithms, neural networks, and optimization techniques."], 
    link: "https://khaos.uma.es/",
  },
]

// Process experiences to add duration
const processedExperiences = EXPERIENCE.map(exp => {
  const dateParts = exp.date.split(' - ')
  const startDate = parseDate(dateParts[0])
  const isOngoing = dateParts[1].toLowerCase().includes('ongoing') || dateParts[1].toLowerCase().includes('present')
  const endDate = isOngoing ? new Date() : parseDate(dateParts[1])
  const duration = calculateDuration(startDate, endDate)
  
  return {
    ...exp,
    duration
  }
})
---

<ol class="relative mt-16 experience-list">
  {
    processedExperiences.map((experience, index) => (
      <li class="experience-list-item" style={`animation-delay: ${index * 0.15}s`}>
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>

<style>
  .experience-list-item {
    opacity: 0;
    animation: fadeInItem 0.6s ease-out forwards;
  }

  @keyframes fadeInItem {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
