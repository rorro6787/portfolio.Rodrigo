---
import ExperienceItem from "./ExperienceItem.astro"
import {
  EXPERIENCE_TREE_ROWS,
  calculateDuration,
  parseDateRange,
  type ExperienceEntry,
} from "@/data/portfolio"

const nowDate = new Date()
const presentLabel = nowDate.toLocaleDateString("en-US", {
  month: "short",
  year: "numeric",
})

function enrichEntry(exp: ExperienceEntry) {
  const { startDate, endDate } = parseDateRange(exp.date, nowDate)
  return {
    ...exp,
    duration: calculateDuration(startDate, endDate),
  }
}

const enrichedRows = EXPERIENCE_TREE_ROWS.map((row) => ({
  left: row.left ? enrichEntry(row.left) : undefined,
  right: row.right ? enrichEntry(row.right) : undefined,
  staggerRight: row.staggerRight ?? false,
}))
---

<!-- Center-Spine Career Tree (Desktop 2-lane tree, Mobile left-spine timeline) -->
<div class="relative mt-10">
  <!-- Continuous Center Vertical Trunk (Desktop) -->
  <div
    class="hidden lg:block absolute top-7 bottom-7 left-1/2 -translate-x-1/2 w-[2px] bg-amber-200 dark:bg-amber-900/50 pointer-events-none"
    aria-hidden="true"
  />

  <!-- Top "Present" anchor -->
  <div class="relative z-10 flex lg:justify-center mb-8 pl-5 lg:pl-0">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/70 shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      Present · {presentLabel}
    </div>
  </div>

  <!-- Mobile left vertical spine -->
  <div class="relative pl-6 ml-3 border-l-2 border-amber-200 dark:border-amber-900/50 lg:border-l-0 lg:pl-0 lg:ml-0 space-y-8 lg:space-y-10">
    {enrichedRows.map((row) => (
      <div class="relative grid grid-cols-1 lg:grid-cols-[1fr_48px_1fr] gap-y-8 lg:gap-y-0 items-start">
        <!-- Left Lane -->
        <div class="relative">
          {row.left && <ExperienceItem {...row.left} side="left" />}
        </div>

        <!-- Center Trunk Spacer (Desktop) -->
        <div class="hidden lg:block" aria-hidden="true" />

        <!-- Right Lane (Parallel concurrent roles) -->
        <div class:list={["relative", row.staggerRight ? "lg:mt-14" : ""]}>
          {row.right && <ExperienceItem {...row.right} side="right" />}
        </div>
      </div>
    ))}
  </div>

  <!-- Bottom Origin Anchor -->
  <div class="relative z-10 hidden lg:flex justify-center mt-8">
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[11px] font-medium text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/60 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500" />
      Started Sept. 2024
    </div>
  </div>
</div>
