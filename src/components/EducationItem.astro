---
interface DetailItem {
  label: string
  value: string
}

interface Props {
  id?: string
  title: string
  company: string
  link?: string
  information?: string
  date: string
  details?: DetailItem[]
  tags?: string[]
}

const { id, title, company, link, information, date, details, tags = [] } = Astro.props
const isOngoing =
  date.toLowerCase().includes("ongoing") ||
  date.toLowerCase().includes("present")
const hasDetails = Boolean((details && details.length > 0) || tags.length > 0)
const href = link || information || "#"
const cardClasses = [
  "edu-card block p-6 rounded-2xl transition-all duration-200 hover:-translate-y-0.5",
  isOngoing
    ? "bg-white dark:bg-zinc-900/85 border border-emerald-300 dark:border-emerald-700/70 shadow-sm hover:shadow-md hover:border-emerald-400 dark:hover:border-emerald-500"
    : "bg-white dark:bg-zinc-900/75 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-300 dark:hover:border-emerald-800/70 hover:shadow-md",
]
---

<article id={id} data-timeline-card={id} class="relative group scroll-mt-24">
  <!-- Left-spine node dot -->
  <div
    class="absolute -left-[32px] top-7 z-10 flex items-center justify-center"
    aria-hidden="true"
  >
    <span
      class:list={[
        "relative w-3.5 h-3.5 rounded-full ring-4 ring-zinc-50 dark:ring-zinc-950 transition-transform duration-200 group-hover:scale-125",
        isOngoing
          ? "bg-emerald-500"
          : "bg-emerald-500/70 dark:bg-emerald-400/70 group-hover:bg-emerald-500",
      ]}
    />
  </div>

  {hasDetails ? (
    <details class:list={[...cardClasses, "group/details"]}>
      <summary class="edu-summary cursor-pointer list-none select-none">
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
          <div class="flex items-start gap-3.5 min-w-0">
            <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/70">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-5 h-5"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M22 9l-10 -4l-10 4l10 4l10 -4v6" />
                <path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4" />
              </svg>
            </div>

            <div class="min-w-0">
              <h3 class="text-lg md:text-xl font-bold text-emerald-700 dark:text-emerald-400">
                {title}
              </h3>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                data-edu-external-link
                class="mt-0.5 inline-flex items-center gap-1.5 text-sm md:text-base font-semibold text-zinc-800 dark:text-zinc-100 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors"
              >
                <span>{company}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-3.5 h-3.5 opacity-60"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  fill="none"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M17 7l-10 10" />
                  <path d="M8 7l9 0l0 9" />
                </svg>
              </a>
            </div>
          </div>

          <div class="flex items-center gap-2 flex-shrink-0 pl-[54px] sm:pl-0">
            <time class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/70">
              {isOngoing && (
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
              )}
              {date}
            </time>
            <span
              aria-hidden="true"
              class="inline-flex items-center justify-center w-8 h-8 rounded-full text-zinc-500 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 group-hover/details:bg-zinc-200/70 dark:group-hover/details:bg-zinc-700/80 group-hover/details:text-zinc-800 dark:group-hover/details:text-zinc-200 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 transition-transform duration-200 group-open/details:rotate-180"
                viewBox="0 0 24 24"
                stroke-width="2.2"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M6 9l6 6l6 -6" />
              </svg>
            </span>
          </div>
        </div>
      </summary>

      {details && details.length > 0 && (
        <dl class="mt-5 pt-4 border-t border-zinc-200 dark:border-zinc-800 grid grid-cols-1 md:grid-cols-2 gap-3">
          {details.map((item) => (
            <div class="p-3 rounded-xl bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/80 dark:border-zinc-800">
              <dt class="text-[11px] font-semibold uppercase tracking-wider text-emerald-700 dark:text-emerald-400 mb-1">
                {item.label}
              </dt>
              <dd class="text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed">
                {item.value}
              </dd>
            </div>
          ))}
        </dl>
      )}

      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-4 pt-3.5 border-t border-zinc-200 dark:border-zinc-800">
          {tags.map((tag) => (
            <span class="px-2.5 py-0.5 text-[11px] font-medium rounded-md text-zinc-700 dark:text-zinc-300 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700/70">
              {tag}
            </span>
          ))}
        </div>
      )}
    </details>
  ) : (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      class:list={cardClasses}
    >
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
        <div class="flex items-start gap-3.5 min-w-0">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl flex items-center justify-center bg-emerald-50 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/70">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M22 9l-10 -4l-10 4l10 4l10 -4v6" />
              <path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4" />
            </svg>
          </div>

          <div class="min-w-0">
            <h3 class="text-lg md:text-xl font-bold text-emerald-700 dark:text-emerald-400">
              {title}
            </h3>
            <p class="mt-0.5 text-sm md:text-base font-semibold text-zinc-800 dark:text-zinc-100 flex items-center gap-1.5">
              <span>{company}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M17 7l-10 10" />
                <path d="M8 7l9 0l0 9" />
              </svg>
            </p>
          </div>
        </div>

        <div class="flex items-center gap-2 flex-shrink-0 pl-[54px] sm:pl-0">
          <time class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800/70">
            {isOngoing && (
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
            )}
            {date}
          </time>
        </div>
      </div>
    </a>
  )}
</article>

<style>
  .edu-summary::-webkit-details-marker {
    display: none;
  }

  :global([data-timeline-card].is-highlighted .edu-card) {
    border-color: rgb(37 99 235 / 0.8);
    box-shadow: 0 0 0 2px rgb(37 99 235 / 0.2);
    transform: translateY(-2px);
  }
</style>

<script>
  function bindExternalEducationLinks() {
    document.querySelectorAll<HTMLAnchorElement>("[data-edu-external-link]").forEach((link) => {
      if (link.dataset.boundStopPropagation === "true") return;
      link.dataset.boundStopPropagation = "true";
      link.addEventListener("click", (event) => {
        event.stopPropagation();
      });
    });
  }

  bindExternalEducationLinks();
  document.addEventListener("astro:page-load", bindExternalEducationLinks);
</script>
