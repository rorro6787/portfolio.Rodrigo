---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    role="link"
    class="inline-flex bg-white text-zinc-800 border-zinc-200 items-center justify-center gap-2 px-3 py-2 space-x-2 text-sm font-medium transition dark:text-zinc-200 dark:bg-zinc-900 border dark:border-zinc-800 hover:bg-zinc-900 hover:border-zinc-900 hover:text-white dark:hover:bg-zinc-100 dark:hover:border-zinc-100 dark:hover:text-zinc-900 group max-w-fit rounded-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/60"
>
    <slot />
</a>
