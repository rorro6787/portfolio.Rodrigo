---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import Experience from "@/components/Experience.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import TitleSection from "@/components/TitleSection.astro"
import TrajectoryTimeline from "@/components/TrajectoryTimeline.astro"
import Publications from "@/components/Publications.astro"
import Education from "@/components/Education.astro"
import Certifications from "@/components/Certifications.astro"
import LanguageCertifications from "@/components/LanguageCertifications.astro"
import Code from "@/components/icons/Code.astro"
import Study from "@/components/icons/study.astro"
import Project from "@/components/icons/project.astro"
import Language from "@/components/icons/Language.astro"
// import SvgEducation from "@/components/icons/Education.astro"
---

<Layout
  title="Rodrigo Carreira's Portfolio - Software & AI Engineer from Málaga, Spain 🇪🇸."
  description="My primary area of expertise is in computer vision and natural language processing (NLP) technologies."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero>
      </slot>
    </Hero>
    </SectionContainer>
    <div class="space-y-24">
    <SectionContainer id="trayectoria">
      <TitleSection>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-8" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M7 18a2 2 0 1 0 0 -4a2 2 0 0 0 0 4z" />
          <path d="M7 6a2 2 0 1 0 0 4a2 2 0 0 0 0 -4z" />
          <path d="M17 6a2 2 0 1 0 0 4a2 2 0 0 0 0 -4z" />
          <path d="M7 10v4" />
          <path d="M17 10c0 3 -10 1 -10 4" />
        </svg>
        Trajectory Overview
      </TitleSection>
      <TrajectoryTimeline />
    </SectionContainer>

    <SectionContainer id="experiencia">
      <TitleSection>
        <Briefcase class="size-8" />
        Work Experience
      </TitleSection>
      <Experience />
    </SectionContainer>

    <SectionContainer id="publicaciones">
      <TitleSection>
        <svg xmlns="http://www.w3.org/2000/svg" class="size-7" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M14 3v4a1 1 0 0 0 1 1h4" />
          <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
          <path d="M9 9l1 0" />
          <path d="M9 13l6 0" />
          <path d="M9 17l6 0" />
        </svg>
        Publications
      </TitleSection>
      <Publications />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <TitleSection>
        <Project class="size-7" />
        Projects
      </TitleSection>
      <Projects />
    </SectionContainer>

    <SectionContainer id="educacion">
      <TitleSection>
        <Study class="size-7" />
        Education
      </TitleSection>
      <Education />
    </SectionContainer>

    <SectionContainer id="idiomas">
      <TitleSection>
        <Language class="size-7" />
        Language Certifications
      </TitleSection>
      <LanguageCertifications />
    </SectionContainer>

    <SectionContainer id="certificaciones">
      <TitleSection>
        <Code class="size-7" />
        Technical Certifications
      </TitleSection>
      <Certifications />
    </SectionContainer>
    
    <SectionContainer id="sobre-mi">
      <TitleSection>
        <ProfileCheck class="size-8" />
        About Me
      </TitleSection>
      <AboutMe />
    </SectionContainer>
  </div>
  </main>
</Layout>
